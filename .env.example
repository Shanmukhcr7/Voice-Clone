# Application
ENV=development
SECRET_KEY=your_super_secret_key_change_in_production
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/voiceclone

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cloudflare R2 Storage (S3 Compatible)
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=voiceclone-assets
R2_PUBLIC_URL=https://pub-<random>.r2.dev

# Firebase Admin SDK (Path to service account JSON, or env vars)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# Billing (e.g. Razorpay/Stripe)
PAYMENT_KEY_ID=your_payment_key
PAYMENT_KEY_SECRET=your_payment_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_secret
